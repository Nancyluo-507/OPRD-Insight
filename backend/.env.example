# ============================================================
# ChemAI - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Database ---
# SQLite (local dev):
#   DATABASE_URL=sqlite:///./database/papers.db
# PostgreSQL (production - e.g. Neon free tier):
#   DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./database/papers.db

# --- Email (choose one) ---

# Option A: SMTP (Gmail, QQ Mail, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Option B: SendGrid (free: 100 emails/day)
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx

# Default sender email
DEFAULT_FROM_EMAIL=ChemAI <noreply@yourdomain.com>

# --- Translation (for Chinese user interests) ---

# Option A: Baidu Translate (free tier) https://console.bce.baidu.com/ai/#/ai/machinetranslation/overview/index
BAIDU_TRANSLATE_APP_ID=
BAIDU_TRANSLATE_API_KEY=
BAIDU_TRANSLATE_SECRET=

# Option B: Any OpenAI-compatible API (DeepSeek recommended, cheap)
# LLM_ENDPOINT=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# --- Data Directory (Docker: set to /data so upgrades don't clear DB) ---
# DATA_DIR=/data

# --- Token Expiry ---
# JWT_EXPIRY_DAYS=7

# --- Cron (protect external cron triggers) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# CRON_SECRET=

# --- Server ---
HOST=0.0.0.0
PORT=8000
# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars

# CORS: comma-separated origins, use * for development
CORS_ORIGINS=*
